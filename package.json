{
  "name": "medpark-backend",
  "version": "1.0.0",
  "description": "MedPark Backend API - Medical Education Platform",
  "author": "MedPark Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build && node esbuild.config.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "set TYPEORM_ENTITIES=ts && npm run typeorm -- migration:generate -d src/config/typeorm.config.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:show": "set TYPEORM_ENTITIES=ts && npm run typeorm -- migration:show -d src/config/typeorm.config.ts",
    "migration:run": "npm run build && npm run typeorm -- migration:run -d src/config/typeorm.config.ts",
    "migration:run:dev": "set TYPEORM_ENTITIES=ts && npm run typeorm -- migration:run -d src/config/typeorm.config.ts",
    "migration:revert": "npm run build && npm run typeorm -- migration:revert -d src/config/typeorm.config.ts",
    "migration:revert:dev": "set TYPEORM_ENTITIES=ts && npm run typeorm -- migration:revert -d src/config/typeorm.config.ts",
    "db:reset": "ts-node -r tsconfig-paths/register scripts/reset-db.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed-runner.ts",
    "seed:profiles": "ts-node -r tsconfig-paths/register src/database/run-profile-seed.ts",
    "deploy": "nest build && npx wrangler deploy",
    "dev:worker": "nest build && npx wrangler dev",
    "import:library-articles": "ts-node -r tsconfig-paths/register src/scripts/import-library-articles.ts",
    "import:amboss-library": "ts-node -r tsconfig-paths/register src/scripts/import-amboss-library.ts",
    "import:pastest-library": "ts-node -r tsconfig-paths/register src/scripts/import-library-articles.ts --db=\"all_db/pastest libraray/my_course_bank.db\" --qbank=\"pastest\" --source=pastest --library-name=pastest",
    "import:pastest-library-2": "ts-node -r tsconfig-paths/register src/scripts/import-library-articles.ts --db=\"all_db/pastest libraray part 2/my_course_bank.db\" --qbank=\"pastest_2\" --source=pastest_2 --library-name=pastest_2",
    "import:passmedicine-library": "ts-node -r tsconfig-paths/register src/scripts/import-library-articles.ts --db=\"all_db/passmedicine-library/my_course_bank.db\" --qbank=\"passmedicine\" --source=passmedicine --library-name=passmedicine",
    "import:one-exam-library": "ts-node -r tsconfig-paths/register src/scripts/import-library-articles.ts --db=\"all_db/one exam library/my_course_bank.db\" --qbank=\"onexamination\" --source=1exam_notes --library-name=\"1exam notes\"",
    "import:passmed-library-part2": "ts-node -r tsconfig-paths/register src/scripts/import-library-articles.ts --db=\"all_db/pass med library part2/my_course_bank.db\" --qbank=\"passmedicine\" --source=pm_library_part_2 --library-name=\"Pm library part 2\"",
    "import:passmed-diagram-library": "ts-node -r tsconfig-paths/register src/scripts/import-library-articles.ts --db=\"all_db/pass med digram library/my_course_bank.db\" --qbank=\"passmedicine\" --source=pm_diagrams --library-name=\"Pm diagrams\"",
    "import:passmed-index-library": "ts-node -r tsconfig-paths/register src/scripts/import-library-articles.ts --db=\"all_db/passmed index library/my_course_bank.db\" --qbank=\"passmedicine\" --source=pm_index --library-name=\"Pm index\"",
    "import:step1": "ts-node -r tsconfig-paths/register src/scripts/import-step.ts --step=1",
    "import:step2": "ts-node -r tsconfig-paths/register src/scripts/import-step.ts --step=2",
    "import:step3": "ts-node -r tsconfig-paths/register src/scripts/import-step.ts --step=3",
    "import:mrcp1": "ts-node -r tsconfig-paths/register src/scripts/import-step.ts --step=4",
    "import:mrcp2": "ts-node -r tsconfig-paths/register src/scripts/import-step.ts --step=5",
    "import:all": "ts-node -r tsconfig-paths/register src/scripts/run-all-imports.ts",
    "import:all:step1": "ts-node -r tsconfig-paths/register src/scripts/run-all-imports.ts -- --step 1",
    "import:all:step2": "ts-node -r tsconfig-paths/register src/scripts/run-all-imports.ts -- --step 2",
    "import:all:step3": "ts-node -r tsconfig-paths/register src/scripts/run-all-imports.ts -- --step 3",
    "import:question-groupings": "ts-node -r tsconfig-paths/register src/scripts/import-question-groupings.ts",
    "gen:question-groupings-bank-map": "ts-node -r tsconfig-paths/register src/scripts/generate-question-groupings-bank-map.ts",
    "verify:question-groupings": "set TYPEORM_ENTITIES=ts && ts-node -r tsconfig-paths/register src/scripts/verify-question-groupings.ts",
    "list:question-banks": "ts-node -r tsconfig-paths/register src/scripts/list-question-banks.ts",
    "seed:uworld-s1-order": "ts-node -r tsconfig-paths/register src/scripts/seed-uworld-s1-order.ts",
    "cleanup:untouched-block-tests": "ts-node -r tsconfig-paths/register src/scripts/cleanup-untouched-block-tests.ts",
    "health:watch": "ts-node -r tsconfig-paths/register src/scripts/health-monitor.ts"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "@google/generative-ai": "^0.24.1",
    "@keyv/redis": "^4.6.0",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.1",
    "@types/compression": "^1.8.1",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.8",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "geoip-lite": "^1.4.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.9.2",
    "jszip": "^3.10.1",
    "keyv": "^5.3.4",
    "openai": "^6.35.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "resend": "^6.12.3",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/sqlite3": "^3.1.11",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "wrangler": "^4.63.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
