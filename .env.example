# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Option A — individual host/port (local dev / self-hosted)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=medpark

# Option B — full connection URL (Supabase / Neon / RDS / Railway etc.)
# DB_URL=postgresql://user:password@host:5432/medpark

# Set to true when using a managed Postgres provider that requires SSL
DB_SSL=false

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
ADMIN_GATE_SECRET=change-me-too

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_BLOCK_DURATION=60
RATE_LIMIT_BACKOFF_WINDOW=1800
RATE_LIMIT_BACKOFF_MULTIPLIER=2
RATE_LIMIT_BACKOFF_MAX_BLOCK_DURATION=3600
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_BLOCK_DURATION=600
PUBLIC_RESOURCE_RATE_LIMIT_TTL=60
PUBLIC_RESOURCE_WRITE_RATE_LIMIT_MAX=30
PUBLIC_RESOURCE_READ_RATE_LIMIT_MAX=40
PUBLIC_RESOURCE_RATE_LIMIT_BLOCK_DURATION=120
TEST_CREATE_RATE_LIMIT_TTL=60
TEST_CREATE_RATE_LIMIT_MAX=10
TEST_CREATE_RATE_LIMIT_BLOCK_DURATION=300
MEDIA_RATE_LIMIT_TTL=60
MEDIA_RATE_LIMIT_MAX=20
MEDIA_RATE_LIMIT_BLOCK_DURATION=300
AI_BURST_RATE_LIMIT_TTL=60
AI_BURST_RATE_LIMIT_MAX=3
AI_BURST_RATE_LIMIT_BLOCK_DURATION=600
JOB_APPLICATION_RATE_LIMIT_TTL=600
JOB_APPLICATION_RATE_LIMIT_MAX=3
JOB_APPLICATION_RATE_LIMIT_BLOCK_DURATION=1800
CONTEST_RATE_LIMIT_MAX=60

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# ─── Redis ───────────────────────────────────────────────────────────────────
# Shared app cache (Redis)
# In production, REDIS_HOST must be set and Redis must be reachable.
# The app will fail to start in production instead of silently using memory cache.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_PREFIX=medpark:
REDIS_TTL=




GOOGLE_CALLBACK_URL=https://dev-api.medpark.live/api/auth/google/callback
FRONTEND_URL=https://dev.medpark.live
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret


####### TELEGRAM BOT #######
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Dedicated monitor bot + group (health checks, 500 errors, startup pings)
# Bot token falls back to TELEGRAM_BOT_TOKEN if not set
# Chat ID falls back to TELEGRAM_ADMIN_CHAT_ID if not set
TELEGRAM_MONITOR_BOT_TOKEN=
TELEGRAM_MONITOR_CHAT_ID=

# Library cache warmup
LIBRARY_CACHE_WARM=false
LIBRARY_CACHE_WARM_SOURCE=amboss

# Resend Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@verify.medpark.io

# Response Encryption (AES-256-GCM)
# Must match VITE_ENCRYPTION_KEY in the frontend .env files
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESPONSE_ENCRYPTION_KEY=replace_with_64_char_hex_string
